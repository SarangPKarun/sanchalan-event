# Sanchalan — Environment Variables
# Copy this file to .env (in the app that needs it, e.g. apps/backend/.env)
# and fill in real values. Never commit the real .env.

# --- Database ---
# Matches docker-compose.yml's local Postgres container by default.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/sanchalan_dev"

# --- WhatsApp (guest RSVP delivery, notification_logs channel="whatsapp") ---
# Not integrated yet — fill in once a WhatsApp Business API provider is chosen.
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=

# --- AI Roadmap Engine (LLM) ---
# Not integrated yet — fill in once the LLM provider for roadmap generation is chosen.
LLM_API_KEY=
LLM_MODEL=

# --- Auth (Phone + OTP) ---
# MSG91 (SMS/OTP provider). Get an authkey from the MSG91 dashboard.
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_BASE_URL=https://api.msg91.com/api/v5/otp

# JWT signing secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP behavior tuning (defaults shown match the spec; omit to use these)
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_MINUTES=10
OTP_MAX_VERIFY_ATTEMPTS=5

# --- App ---
PORT=3000
NODE_ENV=development
