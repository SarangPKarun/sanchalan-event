# Copy to apps/mobile/.env.local (already gitignored via .env*.local) and adjust per target:
#   iOS simulator    -> http://localhost:3000
#   Android emulator -> http://10.0.2.2:3000
#   physical device  -> http://<your-machine-LAN-IP>:3000  (backend must bind 0.0.0.0)
EXPO_PUBLIC_API_URL=http://localhost:3000
