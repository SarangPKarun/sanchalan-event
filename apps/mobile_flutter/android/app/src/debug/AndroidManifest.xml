<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- INTERNET is required for development (hot reload, debugger) and local API calls.
         Cleartext is allowed in debug builds only, so the emulator can reach http://10.0.2.2:3000. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:usesCleartextTraffic="true"/>
</manifest>
