/// [FUTURE] Built now per explicit request. Shareable digital album — photo/video delivery tracking.
model EventMedia {
  id                 String   @id @default(uuid()) @db.Uuid
  eventGroupId       String   @map("event_group_id") @db.Uuid
  mediaUrl           String   @map("media_url")
  uploadedByVendorId String?  @map("uploaded_by_vendor_id") @db.Uuid
  uploadedAt         DateTime @map("uploaded_at")

  eventGroup       EventGroup @relation(fields: [eventGroupId], references: [id])
  uploadedByVendor Vendor?    @relation(fields: [uploadedByVendorId], references: [id])

