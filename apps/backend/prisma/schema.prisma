// =============================================================================
// 9. Notifications & Messaging
// =============================================================================

enum NotificationRecipientType {
  organizer
  vendor
  guest
}

enum NotificationChannel {
  whatsapp
  push
  sms
}

enum NotificationStatus {
  sent
  delivered
  failed
}

/// [ACTIVE] Every WhatsApp/push message sent, for debugging delivery issues
/// and future analytics on what reminder patterns actually get responses.
model NotificationLog {
  id            String                    @id @default(uuid()) @db.Uuid
  recipientType NotificationRecipientType @map("recipient_type")
  recipientId   String                    @map("recipient_id") @db.Uuid
  channel       NotificationChannel
  messageKey    String                    @map("message_key")
  status        NotificationStatus
  scheduledAt   DateTime                  @map("scheduled_at")
  sentAt        DateTime?                 @map("sent_at")

  @@map("notification_logs")
}

// =============================================================================
// 10. Multi-Language Support
// =============================================================================

/// [SCAFFOLD] Not populated with real translations in Phase 1 — but every
/// user-facing generated string already goes through a _key rather than
/// hardcoded English text, so this table resolves keys into other languages later.
model TranslationString {
  id           String @id @default(uuid()) @db.Uuid
  stringKey    String @map("string_key")
  languageCode String @map("language_code")
  text         String

  @@map("translation_strings")
}

// =============================================================================
// 11. Create-or-Delegate Pipelines (Module 3 in the vision doc)
// =============================================================================

enum ProductionPipelineStatus {
  pending
  assigned
  in_production
  delivered
  cancelled
}

/// [FUTURE] Doc mentions this only by name in the module-mapping table:
/// "links tasks ↔ vendors, with a status progression field." Built now per
/// explicit request with a minimal inferred shape (not detailed in the source doc).
model ProductionPipelineItem {
  id        String                   @id @default(uuid()) @db.Uuid
  taskId    String                   @map("task_id") @db.Uuid
  vendorId  String?                  @map("vendor_id") @db.Uuid
  status    ProductionPipelineStatus
  notes     String?
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  task   Task    @relation(fields: [taskId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@map("production_pipeline_items")
}
